# Copy to .env (never commit it) or put these in your MCP client's config.

# --- Required: from Apple Ads > Account Settings > API (signed in as the API user) ---
APPLE_ADS_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Absolute path to the private key made by `apple-ads-mcp keygen` (keep it in secrets/).
APPLE_ADS_PRIVATE_KEY_PATH=/absolute/path/to/apple-ads-mcp/secrets/private-key.pem

# --- Recommended ---
# Default ad account (from apple_ads_list_acls). Tools can override it with ad_account_id.
APPLE_ADS_AD_ACCOUNT_ID=

# --- Safety ---
# true: writes are logged and previewed but NOT sent to Apple Ads.
APPLE_ADS_DRY_RUN=false
# true: register only read-only tools (lists, gets, reports, insights).
APPLE_ADS_READ_ONLY=false
# Budget/bid increases above this percentage need confirm='APPLY'.
APPLE_ADS_MAX_INCREASE_PCT=20
# Comma-separated tool groups to register (default: all). See docs/tools.md.
APPLE_ADS_TOOL_GROUPS=

# --- Audit log (writes only; never report data) ---
# Default: ~/.apple-ads-mcp/logs/audit.jsonl
APPLE_ADS_AUDIT_LOG=
# Entries older than this are deleted when the server starts.
APPLE_ADS_AUDIT_RETENTION_DAYS=30

# --- Other ---
APPLE_ADS_PAGE_SIZE=100
APPLE_ADS_TIMEOUT=30
APPLE_ADS_LOG_LEVEL=INFO
# stdio (Claude Code / Desktop) or streamable-http (served at http://HOST:PORT/mcp)
APPLE_ADS_TRANSPORT=stdio
APPLE_ADS_HOST=127.0.0.1
APPLE_ADS_PORT=8000
